; Copy to TextTools.ini next to TextTools.ahk (or let Settings create it).
; Do not commit TextTools.ini — it holds your API key.

[api]
base_url=https://openrouter.ai/api/v1
api_key=
; Optional HTTP/HTTPS/SOCKS proxy (checkbox in Settings → proxy_on=1):
; proxy=http://user:pass@127.0.0.1:7890
; proxy=socks5h://127.0.0.1:1080
proxy=
proxy_on=0
model=anthropic/claude-haiku-4.5
models=
models_known=

[ui]
hotkey=^!Space
hotkey_repeat=^+Space
markdown=1
lang=en
clip_wait=0.8

[apps]
profiling=0

