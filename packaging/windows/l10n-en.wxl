<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="1252">
  <String Id="ProductLanguage" Overridable="yes">1033</String>
  <String Id="AutostartDlgBody" Overridable="yes">TextTools is a tray app for the selected text. A hotkey runs an action and pastes the result back, or shows it in a window. On Windows it can capture text in other programs. The key stays in the system secret store. MIT license: https://github.com/BelyaevAD/TextTools</String>
  <String Id="AutostartCheck" Overridable="yes">Start TextTools when Windows starts</String>
  <String Id="DesktopShortcutCheck" Overridable="yes">Create a desktop shortcut</String>
  <String Id="StartMenuShortcutCheck" Overridable="yes">Create a Start menu shortcut</String>
  <String Id="LaunchAfterCheck" Overridable="yes">Launch TextTools when setup finishes</String>
</WixLocalization>
