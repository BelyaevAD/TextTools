<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ja-jp" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="932">
  <String Id="ProductLanguage" Overridable="yes">1041</String>
  <String Id="AutostartDlgBody" Overridable="yes">TextTools は選択したテキスト用のトレイアプリです。ホットキーで操作を実行し、結果を貼り戻すかウィンドウに表示します。Windows では他のアプリのテキストも取り込めます。キーはシステムの秘密ストアに残ります。ライセンスは MIT です: https://github.com/BelyaevAD/TextTools</String>
  <String Id="AutostartCheck" Overridable="yes">Windows の起動時に TextTools を起動する</String>
  <String Id="DesktopShortcutCheck" Overridable="yes">デスクトップにショートカットを作成する</String>
  <String Id="StartMenuShortcutCheck" Overridable="yes">スタートメニューにショートカットを作成する</String>
  <String Id="LaunchAfterCheck" Overridable="yes">セットアップの完了後に TextTools を起動する</String>
</WixLocalization>
